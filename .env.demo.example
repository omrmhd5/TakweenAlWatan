# Backend (copy to Back-End/.env for local)

PORT=3000
JWTSECRET=replace-with-a-new-demo-jwt-secret
# Local Mongo while developing
MONGO_URI=mongodb://127.0.0.1:27017/takween-al-watan-demo
# Atlas (used by seed:demo:remote and Render)
MONGO_URI_REMOTE=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/takween-al-watan-demo?retryWrites=true&w=majority
CLIENT_URL=https://takween-al-watan-demo.vercel.app
CORS_ORIGIN=https://takween-al-watan-demo.vercel.app

# Frontend (copy to Front-End/.env for local)

VITE_BACKEND_URL=http://localhost:3000

# Vercel production: VITE_BACKEND_URL=https://takween-al-watan-demo.onrender.com
# Render production: MONGO_URI=Atlas URI with db takween-al-watan-demo, JWTSECRET, CLIENT_URL, CORS_ORIGIN
